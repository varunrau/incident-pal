{
  "name": "incident-pal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "npm run build && node dist/server.js",
    "build": "tsc && npm run build:client",
    "build:client": "esbuild ampersand/client/ampersand.tsx messenger/client/chat.tsx payments/client/app.tsx payments/client/flags.tsx --bundle --minify --format=esm --outdir=dist --outbase=.",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "fastify": "^5.12.8",
    "markdown-it": "^15.0.3",
    "openai": "^7.54.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3"
  }
}
